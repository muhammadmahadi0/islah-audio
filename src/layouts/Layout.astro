---
import '../styles/globals.css';
import Sidebar from '../components/Sidebar';
import BottomNav from '../components/BottomNav';
import MiniPlayer from '../components/Player/MiniPlayer';
import AudioPlayer from '../components/AudioPlayer';
import BetaBadge from '../components/BetaBadge';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
}

const {
  title = 'Islah Audio — Islamic Lectures',
  description = 'Listen to bayans, waz and nasheeds from the Islah channel. Modern audio experience.',
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060D0A" />
    {ogTitle && <meta property="og:title" content={ogTitle} />}
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:type" content="video.other" />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogTitle && <meta name="twitter:card" content="summary_large_image" />}
    {ogTitle && <meta name="twitter:title" content={ogTitle} />}
    {ogDescription && <meta name="twitter:description" content={ogDescription} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    {/* Brand wordmark font — Playfair Display, same as islahbd.com */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Cinzel:wght@700;800&display=swap"
      rel="stylesheet"
    />
    {/* Thumbnails all come from i.ytimg.com — connect early so the first
        image doesn't pay DNS+TLS setup on the critical path. youtube.com
        serves the iframe API, youtube-nocookie.com hosts the embed — both
        are needed the moment the user first taps play. */}
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
    {/* SPA navigation: page swaps without a full reload, so the YT iframe +
        <audio> engines (persisted below) keep playing across Home / Search /
        Library / Boyan / Hamd-Naat. Store persist (islah-player) covers hard
        reloads by restoring the track paused. */}
    <ClientRouter />
    <title>{title}</title>
    {/* Theme + design pre-paint. Runs on first load AND after every SPA
        swap: the ClientRouter replaces <html> attributes from the incoming
        SSR HTML (which carries no classes), wiping `light`/`material` on
        every navigation — so re-apply the saved modes on astro:after-swap.
        Same document throughout, so one listener covers all navigations. */}
    <script is:inline>
      function applySavedModes() {
        try {
          var s = localStorage.getItem('islah-theme');
          var themeMode = null;
          try { themeMode = s && JSON.parse(s).state.theme; } catch (e1) {}
          if (themeMode !== 'light' && themeMode !== 'dark') {
            // No saved choice (first visit): follow the system theme.
            try {
              themeMode = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            } catch (e0) { themeMode = 'dark'; }
          }
          document.documentElement.classList.toggle('light', themeMode === 'light');
          var dm = null;
          try { dm = JSON.parse(localStorage.getItem('islah-design') || 'null'); } catch (e2) {}
          var material = false;
          if (dm && dm.state && dm.state.mode) {
            material = dm.state.mode === 'material';
          } else {
            // No saved choice: Liquid Glass defaults ON for iOS + desktop,
            // OFF (Material 3) for other mobile — mirrors design-store.ts.
            var dua = navigator.userAgent || '';
            var dandroid = /Android/i.test(dua);
            var dios = /iPad|iPhone|iPod/i.test(dua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
            var dmobile = /Mobile|Tablet|Touch|webOS|BlackBerry|IEMobile|Opera Mini/i.test(dua);
            material = dandroid || (!dios && dmobile);
          }
          document.documentElement.classList.toggle('material', material);
          // Persisted app language (islah-lang) — keeps <html lang> correct
          // for screen readers; the React islands rehydrate the strings.
          var lg = null;
          try { lg = JSON.parse(localStorage.getItem('islah-lang') || 'null'); } catch (e3) {}
          document.documentElement.lang = (lg && lg.state && lg.state.lang === 'bn') ? 'bn' : 'en';
        } catch (e) {}
      }
      applySavedModes();
      document.addEventListener('astro:after-swap', applySavedModes);
    </script>
  </head>
  <body class="antialiased bg-ink-950 text-white">
    {/* Ambient refraction blobs behind all content.
        contain:strict isolates their huge blurs so scrolling never repaints them. */}
    <div aria-hidden="true" class="ambient-blobs pointer-events-none fixed inset-0 z-0" style="contain: strict;">
      <div class="absolute -top-32 left-1/2 h-72 w-[38rem] -translate-x-1/2 rounded-full bg-brand/10 blur-[90px] transform-gpu"></div>
      <div class="absolute top-[38vh] -left-32 h-80 w-80 rounded-full bg-brand/[0.06] blur-[90px] transform-gpu"></div>
      <div class="absolute bottom-[-10rem] right-[-6rem] h-96 w-96 rounded-full bg-gold/[0.07] blur-[100px] transform-gpu"></div>
    </div>
    <!-- Liquid-glass floating top bar -->
    <header class="sticky top-2 z-30 mx-2 md:mx-4 mt-2 flex h-14 items-center gap-2 md:gap-4 px-3 md:px-4 rounded-2xl liquid-glass transform-gpu">
      <span aria-hidden="true" class="pointer-events-none absolute top-0 inset-x-12 h-px bg-gradient-to-r from-transparent via-white/70 to-transparent"></span>
      <button
        id="menu-btn"
        class="hidden md:flex h-10 w-10 items-center justify-center rounded-full hover:bg-white/10 transition-colors"
        aria-label="Toggle sidebar"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></svg>
      </button>
      {/* Android: opens the sidebar drawer to see + change channels */}
      <button
        id="menu-btn-mobile"
        class="md:hidden flex h-10 w-10 items-center justify-center rounded-full hover:bg-white/10 transition-colors"
        aria-label="Open menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></svg>
      </button>
      <a href="/" class="flex flex-col items-start justify-center shrink-0 rounded-lg px-2 py-1 leading-none transition-all duration-150 hover:brightness-110 active:scale-95">
        <span class="font-display text-white text-xl font-bold tracking-tight leading-none">islahbd</span>
        <span class="text-[7px] uppercase tracking-[0.18em] text-gold/80 leading-none mt-[2px]">Always Remember Allah</span>
      </a>

      <!-- Desktop search -->
      <div class="hidden md:flex flex-1 justify-center">
        <form action="/search" method="get" class="flex w-full max-w-xl">
          <input
            id="top-search-input"
            type="text"
            name="q"
            placeholder="Search lectures…"
            class="w-full rounded-l-full liquid-input px-5 py-2 text-sm text-white outline-none"
          />
          <button
            id="top-search-btn"
            type="submit"
            aria-label="Search"
            class="rounded-r-full liquid-chip border-l-0 px-5 transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </button>
        </form>
      </div>

      <div class="flex-1 md:hidden"></div>

      <!-- Open IslahBD app (mobile search lives in the bottom nav) -->
      <button
        id="islahbd-btn"
        class="islahbd-open-btn flex h-9 shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-3 md:px-4 text-xs md:text-sm font-bold transition-all active:scale-95"
        aria-label="Open IslahBD app"
        title="Open IslahBD app"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
        <span id="islahbd-btn-label">Open&nbsp;IslahBD</span>
      </button>
    </header>

    <div class="flex relative z-10">
      <!-- Desktop sidebar -->
      <div id="sidebar-wrap" class="hidden md:block sticky top-[4.5rem] h-[calc(100vh-5rem)] shrink-0 px-3 py-1">
        <Sidebar client:only="react" />
      </div>

      <!-- Main content -->
      <main class="flex-1 min-w-0 relative z-10">
        <slot />
      </main>
    </div>

    <!-- Mobile slide-over drawer: nav + channel switcher (slides in, see globals.css) -->
    <div id="mobile-drawer" class="fixed inset-0 z-50 hidden md:hidden">
      <div id="drawer-backdrop" class="drawer-backdrop absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
      <div id="drawer-panel" class="drawer-panel absolute left-2 top-2 bottom-2 w-72 max-w-[85vw] liquid-glass rounded-3xl overflow-hidden">
        <span aria-hidden="true" class="pointer-events-none absolute top-0 inset-x-12 h-px bg-gradient-to-r from-transparent via-white/70 to-transparent"></span>
        <Sidebar mobile={true} client:only="react" />
      </div>
    </div>

    <!-- Floating pill bars + player engines.
         `transition:persist` sits DIRECTLY on the player islands (Astro's
         documented persistent-island pattern): the same <astro-island>
         element — with its live React root, YT iframe and <audio> node —
         is moved into the new page instead of re-created, so playback
         survives every SPA navigation. MiniPlayer itself also never
         unmounts (CSS visibility toggle). -->
    <MiniPlayer client:only="react" transition:persist="islah-mini-player" />
    <BottomNav client:only="react" />
    <BetaBadge client:only="react" />
    <AudioPlayer client:only="react" transition:persist="islah-stream-engine" />

    <script is:inline>
      // Wired once per document (guard): SPA swaps re-execute this inline
      // script, but document-level delegation survives swaps — so register
      // exactly once and let every swapped header/sidebar use it.
      if (!window.__islahLayoutWired) {
        window.__islahLayoutWired = true;
        var SB_KEY = 'islah-sidebar-hidden';
        var applySidebar = function () {
          try {
            document.body.classList.toggle('sb-hidden', localStorage.getItem(SB_KEY) === '1');
          } catch (e) {}
        };
        applySidebar();
        var drawerTimer = null;
        var openDrawer = function (open, instant) {
          var drawer = document.getElementById('mobile-drawer');
          if (!drawer) return;
          if (drawerTimer) {
            clearTimeout(drawerTimer);
            drawerTimer = null;
          }
          if (open) {
            drawer.classList.remove('hidden');
            // Two frames: display applies first, then .open runs the slide.
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                drawer.classList.add('open');
              });
            });
            document.body.classList.add('overflow-hidden');
          } else {
            drawer.classList.remove('open');
            document.body.classList.remove('overflow-hidden');
            if (instant) {
              drawer.classList.add('hidden');
            } else {
              drawerTimer = setTimeout(function () {
                drawer.classList.add('hidden');
                drawerTimer = null;
              }, 320);
            }
          }
        };
        // Hamburger (desktop): slide the sidebar away + remember the choice.
        // Mobile hamburger: slide the drawer in. Backdrop tap closes it.
        document.addEventListener('click', function (e) {
          var t = e.target && e.target.closest ? e.target.closest('#menu-btn,#menu-btn-mobile,#drawer-backdrop') : null;
          if (!t) return;
          if (t.id === 'menu-btn') {
            var hidden = document.body.classList.toggle('sb-hidden');
            try {
              localStorage.setItem(SB_KEY, hidden ? '1' : '0');
            } catch (e2) {}
          } else if (t.id === 'menu-btn-mobile') {
            openDrawer(true);
          } else {
            openDrawer(false);
          }
        });
        // Site-wide water-drop press effect: bloom a droplet from the touch
        // point inside any button/link (CSS animates + fades it).
        document.addEventListener('pointerdown', function (e) {
          var t = e.target && e.target.closest ? e.target.closest('button,a') : null;
          if (!t || t.hasAttribute('data-no-ripple')) return;
          try {
            var rect = t.getBoundingClientRect();
            if (rect.width === 0 && rect.height === 0) return;
            t.classList.add('ripple-host');
            if (t.querySelectorAll('.ripple-ink').length > 2) return;
            var size = Math.max(rect.width, rect.height) * 2.2;
            var ink = document.createElement('span');
            ink.className = 'ripple-ink';
            ink.setAttribute('aria-hidden', 'true');
            var cx = (typeof e.clientX === 'number' && e.clientX > 0 ? e.clientX : rect.left + rect.width / 2) - rect.left;
            var cy = (typeof e.clientY === 'number' && e.clientY > 0 ? e.clientY : rect.top + rect.height / 2) - rect.top;
            ink.style.width = ink.style.height = size + 'px';
            ink.style.left = cx + 'px';
            ink.style.top = cy + 'px';
            t.appendChild(ink);
            setTimeout(function () {
              ink.remove();
            }, 700);
          } catch (err) {}
        });
        document.addEventListener('astro:after-swap', function () {
          applySidebar();
          applyHeaderLang();
          openDrawer(false, true);
        });
        // Header (SSR, not a React island) translation. The persisted
        // language (islah-lang) is the source of truth; the Sidebar's
        // language switch dispatches `islah:lang` for live updates, and
        // swaps re-render the header in English so it must be re-applied.
        var HEADER_STRINGS = {
          en: {
            searchPh: 'Search lectures…',
            searchAria: 'Search',
            menuToggle: 'Toggle sidebar',
            menuOpen: 'Open menu',
            openApp: 'Open IslahBD app',
            openAppLabel: 'Open IslahBD'
          },
          bn: {
            searchPh: 'লেকচার খুঁজুন…',
            searchAria: 'খুঁজুন',
            menuToggle: 'সাইডবার দেখান/লুকান',
            menuOpen: 'মেনু খুলুন',
            openApp: 'IslahBD অ্যাপ খুলুন',
            openAppLabel: 'IslahBD খুলুন'
          }
        };
        var currentLang = 'en';
        var applyHeaderLang = function (lang) {
          try {
            if (!lang) {
              var stored = null;
              try { stored = JSON.parse(localStorage.getItem('islah-lang') || 'null'); } catch (e2) {}
              lang = (stored && stored.state && stored.state.lang === 'bn') ? 'bn' : 'en';
            }
            currentLang = lang;
            var d = HEADER_STRINGS[lang] || HEADER_STRINGS.en;
            var si = document.getElementById('top-search-input');
            if (si) si.setAttribute('placeholder', d.searchPh);
            var sb = document.getElementById('top-search-btn');
            if (sb) sb.setAttribute('aria-label', d.searchAria);
            var mb = document.getElementById('menu-btn');
            if (mb) mb.setAttribute('aria-label', d.menuToggle);
            var mm = document.getElementById('menu-btn-mobile');
            if (mm) mm.setAttribute('aria-label', d.menuOpen);
            var ab = document.getElementById('islahbd-btn');
            if (ab) {
              ab.setAttribute('aria-label', d.openApp);
              ab.setAttribute('title', d.openApp);
            }
            var al = document.getElementById('islahbd-btn-label');
            if (al) al.textContent = d.openAppLabel;
          } catch (e3) {}
        };
        applyHeaderLang();
        document.addEventListener('islah:lang', function (e) {
          applyHeaderLang(e && e.detail);
        });
        document.addEventListener('astro:page-load', function () {
          applyHeaderLang(currentLang);
        });
        // Open IslahBD button (delegated — survives SPA swaps): open the
        // installed app, otherwise go to the right store for the device.
        // Same logic as `src/lib/open-app.ts` on master — keep both in sync.
        // The app registers the `islahbd://` custom scheme (same as the
        // owner's DeepLinkRedirect), so `islahbd://open` just launches it.
        document.addEventListener('click', function (e) {
          var ab = e.target && e.target.closest ? e.target.closest('#islahbd-btn') : null;
          if (!ab) return;
          var ua = navigator.userAgent || '';
          var isAndroid = /Android/i.test(ua);
          var isiOS = /iPad|iPhone|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
          var playStore = 'https://play.google.com/store/apps/details?id=com.islahbd.app';
          var appStore = 'https://apps.apple.com/us/app/islahbd/id6762509692';
          if (isAndroid) {
            window.location.replace('intent://open#Intent;scheme=islahbd;package=com.islahbd.app;S.browser_fallback_url=' + encodeURIComponent(playStore) + ';end');
          } else if (isiOS) {
            var opened = false;
            var onVis = function () { if (document.hidden) opened = true; };
            var onHide = function () { opened = true; };
            document.addEventListener('visibilitychange', onVis);
            window.addEventListener('pagehide', onHide);
            window.addEventListener('blur', onHide);
            window.location.href = 'islahbd://open';
            setTimeout(function () {
              document.removeEventListener('visibilitychange', onVis);
              window.removeEventListener('pagehide', onHide);
              window.removeEventListener('blur', onHide);
              if (!opened && !document.hidden) window.location.replace(appStore);
            }, 2000);
          } else {
            window.open('https://www.islahbd.com/', '_blank', 'noopener');
          }
        });
      }
    </script>
  </body>
</html>
