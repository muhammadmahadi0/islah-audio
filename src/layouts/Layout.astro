---
import '../styles/globals.css';
import Sidebar from '../components/Sidebar';
import BottomNav from '../components/BottomNav';
import MiniPlayer from '../components/Player/MiniPlayer';
import AudioPlayer from '../components/AudioPlayer';
import ThemeToggle from '../components/ThemeToggle';
import BetaBadge from '../components/BetaBadge';

interface Props {
  title?: string;
}

const { title = 'Islah Audio — Islamic Lectures' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="description" content="Listen to bayans, waz and nasheeds from the Islah channel. Modern audio experience." />
    <meta name="theme-color" content="#060D0A" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <title>{title}</title>
    <script is:inline>
      try {
        var s = localStorage.getItem('islah-theme');
        if (s && JSON.parse(s).state.theme === 'light') {
          document.documentElement.classList.add('light');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="antialiased bg-ink-950 text-white">
    <!-- YouTube-style top bar -->
    <header class="sticky top-0 z-30 h-14 flex items-center gap-2 md:gap-4 px-3 md:px-4 bg-ink-950/95 backdrop-blur">
      <button
        id="menu-btn"
        class="hidden md:flex h-10 w-10 items-center justify-center rounded-full hover:bg-white/10 transition-colors"
        aria-label="Toggle sidebar"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></svg>
      </button>
      <a href="/" class="flex items-center shrink-0 px-1">
        <span class="text-white text-lg font-extrabold tracking-[0.18em]">ISLAH</span>
      </a>

      <!-- Desktop search -->
      <div class="hidden md:flex flex-1 justify-center">
        <form action="/search" method="get" class="flex w-full max-w-xl">
          <input
            type="text"
            name="q"
            placeholder="Search lectures…"
            class="w-full rounded-l-full border border-white/15 bg-white/[0.04] px-5 py-2 text-sm text-white placeholder:text-mist-dark outline-none focus:border-brand/60"
          />
          <button
            type="submit"
            aria-label="Search"
            class="rounded-r-full border border-l-0 border-white/15 bg-white/[0.07] px-5 hover:bg-white/[0.12] transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </button>
        </form>
      </div>

      <div class="flex-1 md:hidden"></div>

      <!-- Mobile search icon -->
      <a
        href="/search"
        aria-label="Search"
        class="md:hidden flex h-10 w-10 items-center justify-center rounded-full hover:bg-white/10 transition-colors"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
    </header>

    <div class="flex">
      <!-- Desktop sidebar -->
      <div id="sidebar-wrap" class="hidden md:block sticky top-14 h-[calc(100vh-3.5rem)] shrink-0">
        <Sidebar client:only="react" />
      </div>

      <!-- Main content -->
      <main class="flex-1 min-w-0">
        <slot />
      </main>
    </div>

    <!-- Floating pill bars + player engines -->
    <MiniPlayer client:only="react" />
    <BottomNav client:only="react" />
    <ThemeToggle client:only="react" />
    <BetaBadge client:only="react" />
    <AudioPlayer client:only="react" />

    <script is:inline>
      document.getElementById('menu-btn')?.addEventListener('click', () => {
        document.body.classList.toggle('sb-hidden');
      });
    </script>
  </body>
</html>

<style is:inline>
  body.sb-hidden #sidebar-wrap { display: none; }
</style>
